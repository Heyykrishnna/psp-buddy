generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  FILL_IN_BLANKS
  MATCH_FOLLOWING
  CODING
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum AssessmentType {
  QUIZ
  EXAM
  PRACTICE
}

enum WorkbookStatus {
  PENDING
  PROCESSING
  EVALUATED
  FAILED
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
}

enum TransactionType {
  XP
  COIN
}

enum NotificationType {
  SYSTEM
  ASSESSMENT
  BADGE
  STREAK
  ACHIEVEMENT
  CONTEST
  CHALLENGE
}

enum ProblemProgressStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
}

enum ContestStatus {
  UPCOMING
  LIVE
  ENDED
}

enum AchievementCategory {
  STREAK
  PROBLEMS_SOLVED
  XP
  CONTEST
  BADGE
  SPEED
  PERFECT_SCORE
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  googleId        String?        @unique
  role            RoleName       @default(STUDENT)
  isActive        Boolean        @default(true)
  isEmailVerified Boolean        @default(false)
  isOnboarded     Boolean        @default(false)
  studentRegistrationNo String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        Session[]
  student         Student?
  teacher         Teacher?
  notifications   Notification[]
  auditLogs       AuditLog[]
  chatSessions    ChatSession[]
  submissions     Submission[]
  problemProgress UserProblemProgress[]
  bookmarks       ProblemBookmark[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("sessions")
}

model Teacher {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String   @unique
  department String?
  createdAt  DateTime @default(now())

  @@map("teachers")
}

model Student {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentRegistrationNo String                 @unique
  gradeLevel            String?
  totalXp               Int                    @default(0)
  coins                 Int                    @default(0)
  currentStreak         Int                    @default(0)
  maxStreak             Int                    @default(0)
  lastActivityDate      DateTime?              @map("last_activity_date")
  contestRating         Int                    @default(1200) @map("contest_rating")
  contestsParticipated  Int                    @default(0) @map("contests_participated")
  createdAt             DateTime               @default(now())
  answers               Answer[]
  attempts              AssessmentAttempt[]
  workbookUploads       WorkbookUpload[]
  codingSubmissions     CodingSubmission[]
  xpTransactions        XpTransaction[]
  unlockedBadges        StudentBadge[]
  leaderboardEntries    LeaderboardEntry[]
  topicMasteries        StudentTopicMastery[]
  streakLogs            StreakLog[]
  contestParticipations ContestParticipant[]
  userAchievements      UserAchievement[]
  weeklyProgress        UserWeeklyProgress[]
  dailyChallengeEntries DailyChallengeEntry[]

  @@map("students")
}

// ── Streak Logging ────────────────────────────────────────────────────────────
model StreakLog {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @map("date")
  xpEarned  Int      @default(0) @map("xp_earned")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studentId, date])
  @@map("streak_logs")
}

// ── Daily Challenge ────────────────────────────────────────────────────────────
model DailyChallenge {
  id          String   @id @default(uuid())
  problemId   String   @map("problem_id")
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  challengeDate DateTime @unique @map("challenge_date") @db.Date
  bonusXp     Int      @default(50) @map("bonus_xp")
  createdAt   DateTime @default(now()) @map("created_at")

  entries     DailyChallengeEntry[]

  @@map("daily_challenges")
}

model DailyChallengeEntry {
  id               String         @id @default(uuid())
  challengeId      String         @map("challenge_id")
  challenge        DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  studentId        String         @map("student_id")
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  solved           Boolean        @default(false)
  bonusXpAwarded   Boolean        @default(false) @map("bonus_xp_awarded")
  solvedAt         DateTime?      @map("solved_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([challengeId, studentId])
  @@map("daily_challenge_entries")
}

// ── Weekly Challenges ─────────────────────────────────────────────────────────
model WeeklyChallenge {
  id          String   @id @default(uuid())
  title       String
  description String
  weekNumber  Int      @map("week_number")
  year        Int
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  xpReward    Int      @default(200) @map("xp_reward")
  goalType    String   @default("PROBLEMS_SOLVED") @map("goal_type") // PROBLEMS_SOLVED | XP_EARNED | STREAK_DAYS
  goalTarget  Int      @default(5) @map("goal_target")
  createdAt   DateTime @default(now()) @map("created_at")

  userProgress UserWeeklyProgress[]

  @@unique([weekNumber, year])
  @@map("weekly_challenges")
}

model UserWeeklyProgress {
  id                String          @id @default(uuid())
  weeklyChallengeId String          @map("weekly_challenge_id")
  weeklyChallenge   WeeklyChallenge @relation(fields: [weeklyChallengeId], references: [id], onDelete: Cascade)
  studentId         String          @map("student_id")
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress          Int             @default(0)
  completed         Boolean         @default(false)
  xpAwarded         Boolean         @default(false) @map("xp_awarded")
  completedAt       DateTime?       @map("completed_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([weeklyChallengeId, studentId])
  @@map("user_weekly_progress")
}

// ── Achievements ──────────────────────────────────────────────────────────────
model Achievement {
  id          String              @id @default(uuid())
  key         String              @unique
  title       String
  description String
  icon        String
  category    AchievementCategory
  xpReward    Int                 @default(0) @map("xp_reward")
  threshold   Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  studentId     String      @map("student_id")
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievementId String      @map("achievement_id")
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  @@unique([studentId, achievementId])
  @@map("user_achievements")
}

// ── Contests ──────────────────────────────────────────────────────────────────
model Contest {
  id              String            @id @default(uuid())
  title           String
  description     String
  slug            String            @unique
  status          ContestStatus     @default(UPCOMING)
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  durationMinutes Int               @map("duration_minutes")
  maxParticipants Int?              @map("max_participants")
  isRated         Boolean           @default(true) @map("is_rated")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  problemIds      String[]          @map("problem_ids")
  participants    ContestParticipant[]

  @@map("contests")
}

model ContestParticipant {
  id              String   @id @default(uuid())
  contestId       String   @map("contest_id")
  contest         Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  studentId       String   @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rank            Int?
  score           Float    @default(0)
  solvedCount     Int      @default(0) @map("solved_count")
  penalty         Int      @default(0) // penalty time in minutes
  ratingChange    Int      @default(0) @map("rating_change")
  registeredAt    DateTime @default(now()) @map("registered_at")
  finishedAt      DateTime? @map("finished_at")

  @@unique([contestId, studentId])
  @@map("contest_participants")
}

model StudentTopicMastery {
  id                 String   @id @default(uuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic              String
  assessmentCount    Int      @default(0)
  totalAttempts      Int      @default(0)
  correctAnswers     Int      @default(0)
  accuracy           Float    @default(0)
  averageTimeSeconds Float    @default(0)
  masteryScore       Float    @default(0)
  lastPracticedAt    DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([studentId, topic])
  @@map("student_topic_mastery")
}

model Assessment {
  id                 String              @id @default(uuid())
  title              String
  description        String?
  className          String?
  topic              String?
  assessmentType     AssessmentType      @default(QUIZ)
  totalMarks         Int
  passingMarks       Int
  durationMinutes    Int
  hasNegativeMarking Boolean             @default(false)
  negativeMarkValue  Float               @default(0)
  startTime          DateTime?
  endTime            DateTime?
  dueDate            DateTime?
  isWorkbook         Boolean             @default(false)
  workbookUrl        String?
  isPublished        Boolean             @default(false)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  questions          Question[]
  answers            Answer[]
  attempts           AssessmentAttempt[]
  workbookUploads    WorkbookUpload[]

  @@map("assessments")
}

model Problem {
  id                String          @id @default(uuid())
  slug              String          @unique
  title             String
  description       String
  difficulty        DifficultyLevel @default(EASY)
  functionName      String          @map("function_name")
  starterCodePython String          @map("starter_code_python")
  examples          String?
  constraints       String?
  topics            String[]
  timeLimitMs       Int             @default(2000) @map("time_limit_ms")
  memoryLimitMb     Int             @default(128) @map("memory_limit_mb")
  points            Int             @default(10)
  isPublished       Boolean         @default(false) @map("is_published")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  questions         Question[]
  testCases         TestCase[]
  submissions       Submission[]
  userProgress      UserProblemProgress[]
  bookmarks         ProblemBookmark[]
  dailyChallenges   DailyChallenge[]

  @@map("problems")
}

model Question {
  id                  String           @id @default(uuid())
  assessmentId        String
  assessment          Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problemId           String?
  problem             Problem?         @relation(fields: [problemId], references: [id], onDelete: SetNull)
  questionText        String
  questionType        QuestionType     @default(SINGLE_CHOICE)
  difficulty          DifficultyLevel  @default(MEDIUM)
  topic               String?
  points              Float            @default(1)
  negativeMarks       Float            @default(0)
  orderIndex          Int
  explanation         String?
  trueFalseAnswer     Boolean?
  shortAnswerKeywords String[]
  createdAt           DateTime         @default(now())
  options             Option[]
  answers             Answer[]
  attemptAnswers      AttemptAnswer[]
  testCases           TestCase[]

  @@map("questions")
}

model TestCase {
  id             String    @id @default(uuid())
  problemId      String?   @map("problem_id")
  problem        Problem?  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  questionId     String?   @map("question_id")
  question       Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String    @map("expected_output")
  isHidden       Boolean   @default(false) @map("is_hidden")
  weight         Float     @default(1.0)
  orderIndex     Int       @default(1) @map("order_index")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("test_cases")
}

model Submission {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String           @map("problem_id")
  problem         Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language        String           @default("python")
  sourceCode      String           @map("source_code")
  status          SubmissionStatus @default(PENDING)
  score           Float            @default(0)
  passedTests     Int              @default(0) @map("passed_tests")
  totalTests      Int              @default(0) @map("total_tests")
  runtimeMs       Int?             @map("runtime_ms")
  memoryKb        Int?             @map("memory_kb")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("submissions")
}

model UserProblemProgress {
  id               String                @id @default(uuid())
  userId           String                @map("user_id")
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId        String                @map("problem_id")
  problem          Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status           ProblemProgressStatus @default(NOT_STARTED)
  attempts         Int                   @default(0)
  bestScore        Float                 @default(0) @map("best_score")
  firstAttemptedAt DateTime?             @map("first_attempted_at")
  firstSolvedAt    DateTime?             @map("first_solved_at")
  lastAttemptAt    DateTime              @default(now()) @map("last_attempt_at")

  @@unique([userId, problemId])
  @@map("user_problem_progress")
}

model ProblemBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String   @map("problem_id")
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, problemId])
  @@map("problem_bookmarks")
}

model Option {
  id             String          @id @default(uuid())
  questionId     String
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText     String
  isCorrect      Boolean         @default(false)
  orderIndex     Int
  answers        Answer[]
  attemptAnswers AttemptAnswer[]

  @@map("options")
}

model AssessmentAttempt {
  id            String          @id @default(uuid())
  assessmentId  String
  assessment    Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        AttemptStatus   @default(IN_PROGRESS)
  startedAt     DateTime        @default(now())
  submittedAt   DateTime?
  totalScore    Float?
  maxScore      Float?
  topicAnalysis String?
  answers       AttemptAnswer[]

  @@map("assessment_attempts")
}

model AttemptAnswer {
  id               String            @id @default(uuid())
  attemptId        String
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   Option?           @relation(fields: [selectedOptionId], references: [id])
  textAnswer       String?
  booleanAnswer    Boolean?
  isCorrect        Boolean?
  marksObtained    Float             @default(0)
  savedAt          DateTime          @updatedAt

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

model Answer {
  id               String      @id @default(uuid())
  studentId        String
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   Option?     @relation(fields: [selectedOptionId], references: [id])
  textAnswer       String?
  isCorrect        Boolean?
  marksObtained    Float       @default(0)
  submittedAt      DateTime    @default(now())

  @@map("answers")
}

model WorkbookUpload {
  id             String              @id @default(uuid())
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId   String?
  assessment     Assessment?         @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  fileName       String
  fileUrl        String
  fileSizeBytes  Int                 @default(0)
  mimeType       String              @default("image/png")
  obtainedMarks  Float               @default(0)
  maxMarks       Float               @default(100)
  aiFeedback     String?
  status         WorkbookStatus      @default(PENDING)
  createdAt      DateTime            @default(now())
  evaluatedAt    DateTime?
  evaluations    WorkbookEvaluation[]

  @@map("workbook_uploads")
}

model WorkbookEvaluation {
  id               String         @id @default(uuid())
  workbookUploadId String
  workbookUpload   WorkbookUpload @relation(fields: [workbookUploadId], references: [id], onDelete: Cascade)
  score            Float
  feedback         String?
  evaluatedAt      DateTime       @default(now())

  @@map("workbook_evaluations")
}

model CodingAssignment {
  id               String             @id @default(uuid())
  title            String
  problemStatement String
  allowedLanguages String[]
  timeLimitMs      Int                @default(2000)
  memoryLimitMb    Int                @default(256)
  createdAt        DateTime           @default(now())
  submissions      CodingSubmission[]

  @@map("coding_assignments")
}

model CodingSubmission {
  id              String           @id @default(uuid())
  assignmentId    String
  assignment      CodingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceCode      String
  language        String
  status          SubmissionStatus @default(PENDING)
  executionTimeMs Int?
  memoryUsedKb    Int?
  testCasesPassed Int?
  totalTestCases  Int?
  errorLog        String?
  submittedAt     DateTime         @default(now())

  @@map("coding_submissions")
}

model Badge {
  id             String         @id @default(uuid())
  name           String         @unique
  description    String
  iconUrl        String
  xpRequired     Int            @default(0)
  createdAt      DateTime       @default(now())
  unlockedBadges StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([studentId, badgeId])
  @@map("student_badges")
}

model XpTransaction {
  id              String          @id @default(uuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount          Int
  transactionType TransactionType @default(XP)
  reason          String
  createdAt       DateTime        @default(now())

  @@map("xp_transactions")
}

model LeaderboardEntry {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName String
  avatarUrl   String?
  rank        Int
  totalXp     Int
  timeframe   String   @default("ALL_TIME")
  updatedAt   DateTime @updatedAt

  @@unique([studentId, timeframe])
  @@map("leaderboard_entries")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_codes")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New Chat")
  topic     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // 'user' | 'assistant'
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@map("chat_messages")
}
