    },
    "android": {
      "package": "com.psplumora.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090b"
      }
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f36b9884-ce35-4e98-9661-e5a3d8480df7"
      }
    }
  }
}
